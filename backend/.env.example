PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/mini_erp_crm?schema=public
# Neon/Supabase/Render: use the connection string they provide
DATABASE_URL=

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS - the deployed/local frontend origin
FRONTEND_URL=http://localhost:5173
